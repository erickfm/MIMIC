+// Linux --replay. See replay_host.h.
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "replay_host.h"
+#include "host_services.h"
+#include "slippilib/SlippiGame.h"
+#include <nlohmann/json.hpp>
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <memory>
+#include <unordered_map>
+#include <vector>
+#include <unistd.h>
+
+namespace linux_host::replay {
+namespace {
+std::unique_ptr<Slippi::SlippiGame> g_game;
+MuReplayStart g_start{};
+std::FILE* g_dump = nullptr;
+uint64_t g_events = 0;
+
+// --env (MIMIC RL env): a live match. Each engine frame emits frame start, pre-frames and
+// post-frames, then the game's pad alarm reads the pads it will use for the NEXT frame, then the
+// frame's bookend. So at that pad read the frame's state is final: it is published to the
+// controller over fd g_out and the read blocks on fd g_in for the next frame's pads. Inputs sent
+// after observing frame f land on frame f+1, as with Dolphin + libmelee (blocking input); the
+// frame's bookend arrives at the start of the next message. Before the match, the controller
+// sends one set of pads first: the controller state going into the match, which every pre-match
+// read returns (frame -123 consumes the last of them). Wire format, host -> controller: u32 kind (1 frame, 2 done), u32 size,
+// then `size` bytes of events (u8 command, u32 LE size, payload). Controller -> host: 4 x
+// {u16 button, i8 stick_x, stick_y, sub_x, sub_y, u8 trigger_l, trigger_r} (32 bytes, LE).
+bool g_env = false;
+int g_in = -1, g_out = -1;
+std::vector<uint8_t> g_pending;
+bool g_frame_ready = false;   // a post-frame arrived since the last publish
+bool g_env_started = false;   // the match's first frame has been published
+bool g_have_initial = false;  // the pre-match pads have been read
+bool g_has_first_seed = false;   // --env-seed: the RNG state at the match's first frame
+uint32_t g_first_seed = 0;
+// --env-online-rng: Slippi online's per-frame RNG (its netplay codes overwrite the seed every
+// frame with ((frame + 123) << 16) | the match's low 16 bits), instead of the free-running chain.
+bool g_online_rng = false;
+uint32_t g_idle_reads = 0;    // pad reads since the last frame (after the match started)
+constexpr uint32_t kIdleLimit = 600;   // 10 s of game time with no frame: the match is over
+MuPadStatus g_pads[4]{};
+uint8_t g_port_used[4]{};
+
+bool write_all(int fd, const void* data, size_t size) {
+  const uint8_t* p = (const uint8_t*)data;
+  while (size) {
+    const ssize_t n = ::write(fd, p, size);
+    if (n < 0 && errno == EINTR) continue;
+    if (n <= 0) return false;
+    p += n; size -= (size_t)n;
+  }
+  return true;
+}
+
+bool read_all(int fd, void* data, size_t size) {
+  uint8_t* p = (uint8_t*)data;
+  while (size) {
+    const ssize_t n = ::read(fd, p, size);
+    if (n < 0 && errno == EINTR) continue;
+    if (n <= 0) return false;
+    p += n; size -= (size_t)n;
+  }
+  return true;
+}
+
+bool publish(uint32_t kind) {
+  const uint32_t head[2] = {kind, (uint32_t)g_pending.size()};
+  const bool ok = write_all(g_out, head, sizeof head) && write_all(g_out, g_pending.data(), g_pending.size());
+  g_pending.clear();
+  g_frame_ready = false;
+  return ok;
+}
+
+void logf(const char* fmt, ...) __attribute__((format(printf, 1, 2)));
+void logf(const char* fmt, ...) {
+  char line[512];
+  va_list args;
+  va_start(args, fmt);
+  std::vsnprintf(line, sizeof line, fmt, args);
+  va_end(args);
+  std::fprintf(stderr, "replay: %s\n", line);
+}
+
+// Dolphin's denylist: injections that do not affect gameplay (Sys/Slippi/InjectionLists, later
+// files winning) plus a fixed backward-compatibility set. Same as port/runtime/hle/slippi_playback.cpp.
+std::unordered_map<uint32_t, bool> build_denylist(const std::string& sys_dir) {
+  std::unordered_map<uint32_t, bool> deny = {
+      {0x802fef88, true}, {0x8006c5d8, true}, {0x8016d30c, true}, {0x8016e9b4, true},
+      {0x802f6690, true}, {0x802F71E0, true}, {0x80071960, true}, {0x800CC818, true}, {0x8008A478, true},
+  };
+  std::filesystem::path dir = std::filesystem::path(sys_dir) / "Slippi" / "InjectionLists";
+  std::vector<std::pair<int, std::filesystem::path>> files;
+  std::error_code ec;
+  for (auto& e : std::filesystem::directory_iterator(dir, ec)) {
+    if (!e.is_regular_file()) continue;
+    const std::string stem = e.path().stem().string();
+    const size_t us = stem.find_last_of('_');
+    files.push_back({us != std::string::npos ? std::atoi(stem.substr(us + 1).c_str()) : 0, e.path()});
+  }
+  if (files.empty()) logf("no injection lists under %s: every code counts as gameplay", dir.c_str());
+  std::stable_sort(files.begin(), files.end(), [](auto& a, auto& b) { return a.first < b.first; });
+  for (auto& [num, path] : files) {
+    std::ifstream f(path);
+    const std::string contents((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+    auto res = nlohmann::json::parse(contents, nullptr, false);
+    if (res.is_discarded() || !res.is_object() || !res.count("Details") || !res["Details"].is_array()) continue;
+    for (auto& inj : res["Details"]) {
+      if (!inj.is_object()) continue;
+      const std::string tags = inj.count("Tags") && inj["Tags"].is_string() ? inj["Tags"].get<std::string>() : "";
+      const std::string addr = inj.count("InjectionAddress") && inj["InjectionAddress"].is_string()
+                                   ? inj["InjectionAddress"].get<std::string>() : "";
+      if (!addr.empty()) deny[(uint32_t)std::strtoul(addr.c_str(), nullptr, 16)] = tags.find("[affects-gameplay]") == std::string::npos;
+    }
+  }
+  deny[0x8038add0] = true;   // PreventMusicAlarm (rollback display off)
+  deny[0x80023FFC] = true;   // MuteMusic
+  return deny;
+}
+
+// Which of the replay's gameplay codes the native game implements, by injection address. Same
+// table as replay_codes in port/app/source_host.cpp.
+uint32_t replay_codes(const std::vector<uint8_t>& list, const std::string& sys_dir, uint8_t* ps_frozen_toggle) {
+  struct Known { uint32_t address; uint32_t code; };
+  static const Known known[] = {
+      {0x800D65EC, MU_REPLAY_CODE_UCF084}, {0x800C9A44, MU_REPLAY_CODE_UCF084}, {0x8006B460, MU_REPLAY_CODE_UCF084},
+      {0x8008E54C, MU_REPLAY_CODE_UCF084}, {0x8009A0B8, MU_REPLAY_CODE_UCF084}, {0x800998A4, MU_REPLAY_CODE_UCF084},
+      {0x80093294, MU_REPLAY_CODE_UCF084}, {0x800908F4, MU_REPLAY_CODE_UCF084},
+      {0x8016E510, MU_REPLAY_CODE_NEUTRAL_SPAWN}, {0x801239A8, MU_REPLAY_CODE_FREEZE_GLITCH},
+      {0x801C154C, MU_REPLAY_CODE_INIT_STAGE_DATA}, {0x80068EEC, MU_REPLAY_CODE_INIT_PLAYER_DATA},
+      {0x8006A880, MU_REPLAY_CODE_OFFSCREEN_DAMAGE}, {0x800D4C1C, MU_REPLAY_CODE_DEAD_UP_FALL},
+      {0x800D4D68, MU_REPLAY_CODE_DEAD_UP_FALL}, {0x80080E80, MU_REPLAY_CODE_DEAD_UP_FALL},
+      {0x8021AAE4, MU_REPLAY_CODE_FD_BG_SEED}, {0x801C65C8, MU_REPLAY_CODE_PS_ZERO_BUFFER},
+      {0x801D4760, MU_REPLAY_CODE_PS_IS_VALID}, {0x801D457C, MU_REPLAY_CODE_PS_FROZEN_CHECK},
+      {0x800165AC, MU_REPLAY_CODE_PS_FILE_LOAD}, {0x8008653C, MU_REPLAY_CODE_WHISPY_FIX},
+      {0x800AC5B8, MU_REPLAY_CODE_NANA_DETERMINISM}, {0x801D24FC, MU_REPLAY_CODE_PS_MONITOR},
+      {0x800DB880, MU_REPLAY_CODE_PREVENT_WOBBLING}, {0x800DBBD4, MU_REPLAY_CODE_PREVENT_WOBBLING},
+      {0x8008F090, MU_REPLAY_CODE_PREVENT_WOBBLING},
+      // Not gameplay: results screen panels, the online static data table, the HUD stock display.
+      {0x80179378, 0}, {0x8017900C, 0}, {0x8017A890, 0}, {0x8000568C, 0}, {0x802F84C8, 0},
+  };
+  const auto deny = build_denylist(sys_dir);
+  uint32_t codes = 0;
+  size_t idx = 0, kept = 0, dropped = 0, unknown = 0;
+  while (idx + 8 <= list.size()) {
+    const uint8_t type = list[idx] & 0xFE;
+    uint32_t address = (uint32_t)list[idx] << 24 | (uint32_t)list[idx + 1] << 16 | (uint32_t)list[idx + 2] << 8 | list[idx + 3];
+    address = (address & 0x01FFFFFF) | 0x80000000;
+    const uint32_t word = (uint32_t)list[idx + 4] << 24 | (uint32_t)list[idx + 5] << 16 | (uint32_t)list[idx + 6] << 8 | list[idx + 7];
+    size_t len = 8;
+    if (type == 0xC0 || type == 0xC2) len = 8 + (size_t)word * 8;
+    else if (type == 0x08) len = 16;
+    else if (type == 0x06) len = 8 + ((word + 7) & ~7u);
+    if (idx + len > list.size()) break;
+    const auto it = deny.find(address);
+    if (it != deny.end() && it->second) { ++dropped; idx += len; continue; }
+    ++kept;
+    const Known* k = nullptr;
+    for (const auto& e : known) if (e.address == address) { k = &e; break; }
+    if (!k) {
+      ++unknown;
+      logf("code %08X (type %02X, %zu bytes) is not implemented natively; this replay may diverge", address, type, len);
+      if ((address == 0x800C9A44 || address == 0x800998A4) && !(codes & MU_REPLAY_CODE_UCF084)) codes |= MU_REPLAY_CODE_UCF_OTHER;
+    } else {
+      codes |= k->code;
+      if (address == 0x801D457C && len >= 8 + 12) *ps_frozen_toggle = list[idx + 8 + 8];
+    }
+    idx += len;
+  }
+  logf("code list %zu bytes, %zu gameplay codes kept (%zu denylisted), %zu not native; codes mask %08X",
+       list.size(), kept, dropped, unknown, codes);
+  return codes;
+}
+
+const MuReplayStart* h_start() { return g_game ? &g_start : nullptr; }
+
+void h_frame(int32_t frame, MuReplayFrame* out) {
+  *out = MuReplayFrame{};
+  if (g_env) {   // live: no recorded frames; the RNG runs free after the optional first-frame seed
+    out->result = MU_REPLAY_CONTINUE;
+    if (g_online_rng) {
+      out->seed_exists = 1;
+      out->seed = ((uint32_t)(frame - Slippi::GAME_FIRST_FRAME) << 16) | (g_first_seed & 0xFFFFu);
+    } else if (frame == Slippi::GAME_FIRST_FRAME && g_has_first_seed) {
+      out->seed_exists = 1;
+      out->seed = g_first_seed;
+    }
+    return;
+  }
+  if (!g_game || !g_game->DoesFrameExist(frame)) { out->result = MU_REPLAY_TERMINATE; return; }
+  Slippi::FrameData* f = g_game->GetFrame(frame);
+  out->result = MU_REPLAY_CONTINUE;
+  out->seed_exists = f->randomSeedExists ? 1 : 0;
+  out->seed = f->randomSeed;
+  for (uint8_t port = 0; port < 4; ++port) {
+    for (int follower = 0; follower < 2; ++follower) {
+      const auto& source = follower ? f->followers : f->players;
+      const auto it = source.find(port);
+      if (it == source.end()) continue;
+      const Slippi::PlayerFrameData& d = it->second;
+      MuReplayCharacter& c = out->character[port][follower];
+      c.present = 1;
+      c.random_seed = d.randomSeed;
+      c.joystick_x = d.joystickX; c.joystick_y = d.joystickY; c.cstick_x = d.cstickX; c.cstick_y = d.cstickY;
+      c.trigger = d.trigger;
+      c.buttons = d.buttons;
+      c.x = d.locationX; c.y = d.locationY; c.facing = d.facingDirection;
+      c.action_state = d.animation;
+      c.percent = d.percent;
+      c.joystick_x_raw = d.joystickXRaw; c.joystick_y_raw = d.joystickYRaw;
+      c.cstick_x_raw = d.cstickXRaw; c.cstick_y_raw = d.cstickYRaw;
+    }
+  }
+}
+
+int32_t h_stock_steal(int32_t frame, int32_t port) {
+  if (g_env) return 0;
+  if (!g_game || !g_game->DoesFrameExist(frame)) return 0;
+  return g_game->GetFrame(frame)->players.count((uint8_t)port) ? 1 : 0;
+}
+
+// Dump format, per event: u8 command, u32 little-endian size, payload. The checker reads it.
+void h_event(uint8_t command, const uint8_t* payload, uint32_t size) {
+  if (g_env) {
+    static const bool trace = std::getenv("MELEE_ENV_TRACE") != nullptr;
+    if (trace && size >= 4)
+      std::fprintf(stderr, "event %02X frame %d\n", command, (int)((uint32_t)payload[0] << 24 | (uint32_t)payload[1] << 16 | (uint32_t)payload[2] << 8 | payload[3]));
+    g_pending.push_back(command);
+    const uint8_t n[4] = {(uint8_t)size, (uint8_t)(size >> 8), (uint8_t)(size >> 16), (uint8_t)(size >> 24)};
+    g_pending.insert(g_pending.end(), n, n + 4);
+    g_pending.insert(g_pending.end(), payload, payload + size);
+    if (command == 0x38) g_frame_ready = true;
+    return;
+  }
+  if (!g_dump) return;
+  std::fputc(command, g_dump);
+  const uint8_t n[4] = {(uint8_t)size, (uint8_t)(size >> 8), (uint8_t)(size >> 16), (uint8_t)(size >> 24)};
+  std::fwrite(n, 1, 4, g_dump);
+  if (size) std::fwrite(payload, 1, size, g_dump);
+  ++g_events;
+}
+
+void h_finished() {
+  if (g_env) {
+    publish(2);
+    request_stop(0);
+    return;
+  }
+  logf("playback finished after %llu events", (unsigned long long)g_events);
+  if (g_dump) { std::fclose(g_dump); g_dump = nullptr; }
+  request_stop(0);
+}
+}  // namespace
+
+static bool prepare_start(const std::string& path, const std::string& sys_dir) {
+  g_game = Slippi::SlippiGame::FromFile(path);
+  if (!g_game || !g_game->AreSettingsLoaded()) { logf("cannot read %s", path.c_str()); g_game.reset(); return false; }
+  Slippi::GameSettings* s = g_game->GetSettings();
+  std::array<uint32_t, Slippi::GAME_INFO_HEADER_SIZE> header = s->header;
+  // Dolphin's prepareGameInfo: a player who is Sheik or Zelda gets that character in the header.
+  for (int i = 0; i < 4; ++i) {
+    if (!g_game->DoesPlayerExist((int8_t)i)) continue;
+    const uint8_t ext = s->players[(uint8_t)i].characterId;
+    if (ext != 0x12 && ext != 0x13) continue;
+    header[24 + 9 * i] = (header[24 + 9 * i] & 0x00FFFFFFu) | (uint32_t)ext << 24;
+  }
+  for (int i = 0; i < Slippi::GAME_INFO_HEADER_SIZE; ++i)
+    for (int b = 0; b < 4; ++b) g_start.game_info[4 * i + b] = (uint8_t)(header[i] >> (24 - 8 * b));
+  g_start.random_seed = s->randomSeed;
+  g_start.is_pal = s->isPAL;
+  const auto version = g_game->GetVersion();
+  g_start.preload_ps = version[0] > 1 || (version[0] == 1 && version[1] > 2);
+  g_start.frozen_ps = s->isFrozenPS;
+  g_start.resync = std::getenv("MELEE_REPLAY_RESYNC") != nullptr;   // off: inputs only
+  g_start.codes = replay_codes(s->geckoCodes, sys_dir, &g_start.ps_frozen_toggle);
+  logf("%s, Slippi %s, frames %d..%d, stage %u, seed %08X%s", path.c_str(), g_game->GetVersionString().c_str(),
+       Slippi::GAME_FIRST_FRAME, g_game->GetLatestIndex(), (unsigned)s->stage, s->randomSeed,
+       g_start.resync ? ", RESYNC ON" : "");
+  return true;
+}
+
+bool load(const std::string& path, const std::string& sys_dir, const std::string& dump_path) {
+  if (!prepare_start(path, sys_dir)) return false;
+  g_dump = std::fopen(dump_path.c_str(), "wb");
+  if (!g_dump) { logf("cannot write %s", dump_path.c_str()); g_game.reset(); return false; }
+  return true;
+}
+
+bool load_env(const std::string& template_slp, const std::string& sys_dir, int fd_in, int fd_out,
+              bool has_seed, uint32_t seed, bool online_rng) {
+  if (!prepare_start(template_slp, sys_dir)) return false;
+  g_start.live = 1;
+  g_start.resync = 0;
+  // START never pauses an env match (a policy pressing it would freeze the episode; Slippi
+  // online disables pausing too). Game info byte 2, bit 3: the rules' disable_pausing.
+  g_start.game_info[2] |= 0x08;
+  g_has_first_seed = has_seed;
+  g_first_seed = seed;
+  g_online_rng = online_rng;
+  for (int i = 0; i < 4; ++i) g_port_used[i] = g_start.game_info[0x60 + 0x24 * i + 1] != 3;   // player type 3: none
+  g_env = true;
+  g_in = fd_in;
+  g_out = fd_out;
+  logf("env: live match from %s, %s RNG, seed %s%08X, ports %d%d%d%d", template_slp.c_str(),
+       online_rng ? "online" : "offline", has_seed ? "" : "(setup's) ", has_seed ? seed : g_start.random_seed,
+       g_port_used[0], g_port_used[1], g_port_used[2], g_port_used[3]);
+  return true;
+}
+
+bool env_active() { return g_env; }
+
+static void read_pads() {
+  uint8_t wire[32];
+  if (!read_all(g_in, wire, sizeof wire)) {
+    logf("env: controller closed the pipe; stopping");
+    request_stop(0);
+    return;
+  }
+  for (int i = 0; i < 4; ++i) {
+    const uint8_t* w = wire + 8 * i;
+    MuPadStatus& p = g_pads[i];
+    p.button = (uint16_t)(w[0] | w[1] << 8);
+    p.stick_x = (int8_t)w[2]; p.stick_y = (int8_t)w[3];
+    p.sub_x = (int8_t)w[4]; p.sub_y = (int8_t)w[5];
+    p.trigger_l = w[6]; p.trigger_r = w[7];
+    p.analog_a = p.analog_b = 0;
+  }
+}
+
+void env_pads(MuPadStatus out[4]) {
+  if (!g_have_initial) { g_have_initial = true; read_pads(); }
+  static const bool trace = std::getenv("MELEE_ENV_TRACE") != nullptr;
+  if (trace) std::fprintf(stderr, "pad_read (frame_ready=%d)\n", (int)g_frame_ready);
+  if (g_env_started && !g_frame_ready && ++g_idle_reads >= kIdleLimit) {
+    // No frame for 10 s of retraces: the match ended without the replay-finished callback (a
+    // post-match scene polling pads), or the game is stuck. Report done instead of hanging.
+    logf("env: no frame for %u pad reads; reporting done", g_idle_reads);
+    publish(2);
+    request_stop(0);
+  }
+  if (g_frame_ready) {
+    g_env_started = true;
+    g_idle_reads = 0;
+    if (!publish(1)) {
+      logf("env: controller closed the pipe; stopping");
+      request_stop(0);
+    } else {
+      read_pads();
+    }
+  }
+  for (int i = 0; i < 4; ++i) {
+    out[i] = g_pads[i];
+    out[i].err = g_port_used[i] ? 0 : -1;
+  }
+}
+
+bool active() { return g_game != nullptr; }
+
+void install(MuHostApi& h) {
+  h.replay_start = h_start; h.replay_frame = h_frame; h.replay_stock_steal = h_stock_steal;
+  h.replay_event = h_event; h.replay_finished = h_finished;
+}
+}  // namespace linux_host::replay
