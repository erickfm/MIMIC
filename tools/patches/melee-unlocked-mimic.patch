+// Linux --replay: the host side of Slippi replay playback (MuHostApi version 9), for fidelity checks.
+// Plays one .slp's recorded inputs (resync off: positions/actions are simulated, not restored) and
+// dumps every event the game emits, so a checker can diff the native post-frames against the
+// recording byte for byte. Port of the Windows source host's --replay (port/app/source_host.cpp).
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+#include "mu_host.h"
+#include <string>
+
+namespace linux_host::replay {
+// Parse the replay and prepare the game info. False with a message on stderr when unreadable.
+bool load(const std::string& slp_path, const std::string& sys_dir, const std::string& dump_path);
+bool active();
+// --env: a live match entered from template_slp's game info and code list, pads from fd_in, each
+// finished frame's events to fd_out (wire format in replay_host.cpp). has_seed: the RNG state at
+// the match's first frame (-123), restored once; the RNG then runs free. online_rng: Slippi
+// online's per-frame seed instead ((frame + 123) << 16 | seed's low 16 bits).
+bool load_env(const std::string& template_slp, const std::string& sys_dir, int fd_in, int fd_out,
+              bool has_seed, uint32_t seed, bool online_rng);
+bool env_active();
+void env_pads(MuPadStatus out[4]);   // pad_read in env mode
+void install(MuHostApi& h);   // fills the version 9 replay group
+}  // namespace linux_host::replay
